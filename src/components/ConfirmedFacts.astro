---
interface Props { items: string[]; }
const { items } = Astro.props;
---
<section class="card confirmed" aria-labelledby="confirmed-title">
  <span class="eyebrow">Confirmed</span>
  <h2 id="confirmed-title">What is verified</h2>
  <ul>{items.map((item) => <li set:html={item} />)}</ul>
</section>
