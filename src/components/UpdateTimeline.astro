---
interface UpdateItem { date: string; title: string; summary: string; href: string; sourceId: string; }
interface Props { items: UpdateItem[]; }
const { items } = Astro.props;
---
<section aria-labelledby="updates-title">
  <h2 id="updates-title">Official Update Timeline</h2>
  <div class="grid">
    {items.map((item) => (
      <article class="card">
        <span class="badge">{item.date}</span>
        <h3><a href={item.href}>{item.title}</a></h3>
        <p>{item.summary}</p>
        <p class="muted">Source: {item.sourceId}</p>
      </article>
    ))}
  </div>
</section>
