---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Guide not found"
  description="This guide route does not have a published page."
  path="/404/"
>
  <section class="shell copy section">
    <span class="eyebrow">404</span>
    <h1>Guide not found</h1>
    <p>The requested player task does not have a published guide yet.</p>
    <a class="button-link" href="/guide/">Browse the Complete Guide</a>
  </section>
</BaseLayout>
